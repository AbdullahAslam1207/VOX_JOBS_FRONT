# Backend base URL used by most API calls
VITE_BACKEND_URL=https://21g0pfhj-8000.inc1.devtunnels.ms

# Optional: separate base URL for chat endpoint
# If omitted, VITE_BACKEND_URL is used.
VITE_CHAT_BACKEND_URL=https://n5rrrx4s-8000.asse.devtunnels.ms

# Optional: separate base URL for vector store endpoint
# If omitted, VITE_CHAT_BACKEND_URL (or VITE_BACKEND_URL) is used.
VITE_VECTOR_STORE_URL=http://localhost:8000

# Optional: override websocket base URL used by Mock Interview
# If omitted, VITE_BACKEND_URL is used.
VITE_MOCK_INTERVIEW_BASE_URL=http://localhost:8000

# Optional: full websocket URL for mock interview when hosted on a different server
# Example: wss://<forwarded-host>/ws/mock_interview_voice
VITE_MOCK_INTERVIEW_WS_URL=
